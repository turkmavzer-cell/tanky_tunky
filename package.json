{
  "name": "tanky-tunky",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "bench:engines": "node bench/run-bench.mjs",
    "log": "node tools/changelog.mjs",
    "audio:check": "vite build -c tools/vite.audio.config.ts && node tools/audio-check.mjs",
    "e2e": "playwright test --project=mobile-landscape",
    "apk:debug": "npm run build && npx cap sync android && cd android && ./gradlew assembleDebug",
    "check": "npm run lint && npm run typecheck && npm test && npm run build && npm run e2e && npm run e2e:perf",
    "e2e:perf": "playwright test --project=perf --workers=1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.56.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "phaser": "^4.2.1",
    "pixi.js": "^8.22.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "react": "19.2",
    "react-dom": "19.2"
  }
}
